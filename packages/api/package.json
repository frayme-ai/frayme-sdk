{
  "name": "@frayme/api",
  "version": "0.5.0",
  "description": "Frayme API client — zero-dependency, fetch-based, streaming generative-UI compose for Node, edge, Bun, Deno, and Workers.",
  "homepage": "https://frayme.ai",
  "keywords": [
    "generative-ui",
    "ai-agents",
    "mcp",
    "json-render",
    "llm",
    "react",
    "streaming"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frayme-ai/frayme-sdk.git",
    "directory": "packages/api"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@frayme/catalog": "^0.4.0"
  },
  "peerDependencies": {
    "@json-render/core": "^0.19.0",
    "zod": "^4.0.0",
    "ai": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@json-render/core": "^0.19.0",
    "ai": "^6.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6",
    "zod": "^4.0.0"
  }
}

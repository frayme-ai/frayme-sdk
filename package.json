{
  "name": "@frayme/sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Frayme SDK monorepo (public, MIT) \u2014 distribution layer for Frayme.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm -ws --if-present run build",
    "type-check": "npm -ws --if-present run type-check",
    "clean": "npm -ws --if-present run clean",
    "postinstall": "npm -w @frayme/catalog --if-present run build",
    "docs:components": "node tools/render-docs.mjs",
    "test": "npm -ws --if-present run test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.31.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  }
}
